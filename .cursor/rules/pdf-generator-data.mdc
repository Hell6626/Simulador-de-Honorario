# Regras do Gerador de PDF - Maximização de Dados

## Objetivo
O gerador de PDF deve incluir o máximo possível de informações relevantes sem comprometer o layout estabelecido.

## Dados Obrigatórios a Incluir

### Informações do Cliente (Alta Prioridade)
```python
def _preparar_dados_cliente_completos(self, cliente):
    """Prepara dados COMPLETOS do cliente para o PDF"""
    dados_base = {
        'id': cliente.id,
        'nome': cliente.nome,
        'cpf': cliente.cpf,
        'email': cliente.email,
        'telefone': getattr(cliente, 'telefone', None),
        'ativo': cliente.ativo,
        'created_at': cliente.created_at,
        'updated_at': cliente.updated_at,
    }
    
    # Dados de endereço se disponível
    if hasattr(cliente, 'enderecos') and cliente.enderecos:
        endereco = cliente.enderecos[0]  # Primeiro endereço
        dados_base.update({
            'endereco_completo': f"{endereco.logradouro}, {endereco.numero}",
            'bairro': endereco.bairro,
            'cidade': endereco.cidade,
            'estado': endereco.estado,
            'cep': endereco.cep,
        })
    
    # Dados de entidade jurídica se PJ
    if hasattr(cliente, 'entidades_juridicas') and cliente.entidades_juridicas:
        entidade = cliente.entidades_juridicas[0]
        dados_base.update({
            'razao_social': entidade.nome,
            'nome_fantasia': getattr(entidade, 'nome_fantasia', None),
            'cnpj': entidade.cnpj,
            'inscricao_estadual': getattr(entidade, 'inscricao_estadual', None),
            'regime_tributario': getattr(entidade, 'regime_tributario', None),
            'faixa_faturamento': getattr(entidade, 'faixa_faturamento', None),
        })
    
    return dados_base
```

### Informações da Proposta (Alta Prioridade)
```python
def _preparar_dados_proposta_completos(self, proposta):
    """Prepara dados COMPLETOS da proposta"""
    return {
        'id': proposta.id,
        'numero': proposta.numero,
        'data_criacao': proposta.created_at.strftime('%d/%m/%Y'),
        'data_validade': (proposta.created_at + timedelta(days=30)).strftime('%d/%m/%Y'),
        'status': proposta.status,
        'valor_total': proposta.valor_total,
        'valor_mensalidade': proposta.valor_mensalidade,
        'percentual_desconto': proposta.percentual_desconto,
        'observacoes': getattr(proposta, 'observacoes', None),
        'responsavel': getattr(proposta, 'responsavel', None),
    }
```

