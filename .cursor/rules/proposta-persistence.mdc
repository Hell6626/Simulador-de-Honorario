## Gerenciamento de Estado

### Store de Proposta
```typescript
// PropostaStore.tsx - Adicionar ações de persistência
type PropostaAction =
  | { type: 'SET_PROPOSTA_ID'; payload: string }
  | { type: 'SET_PROPOSTA_EM_ANDAMENTO'; payload: { id: string; timestamp: string } }
  | { type: 'CLEAR_PROPOSTA_EM_ANDAMENTO' }
  | { type: 'SALVAR_PROGRESSO_PASSO'; payload: { passo: number; dados: any } }
  | // ... outras ações existentes

// Adicionar ao reducer
case 'SET_PROPOSTA_ID':
  return {
    ...state,
    propostaId: action.payload
  };

case 'SET_PROPOSTA_EM_ANDAMENTO':
  localStorage.setItem('proposta_em_andamento_id', action.payload.id);
  localStorage.setItem('proposta_em_andamento_timestamp', action.payload.timestamp);
  return {
    ...state,
    propostaId: action.payload.id
  };

case 'CLEAR_PROPOSTA_EM_ANDAMENTO':
  localStorage.removeItem('proposta_em_andamento_id');
  localStorage.removeItem('proposta_em_andamento_timestamp');
  return {
    ...state,
    propostaId: null
  };
```

### Hook de Persistência
```typescript
// usePropostaPersistence.ts
export const usePropostaPersistence = () => {
  const { dispatch } = usePropostaStore();
  
  const iniciarProposta = useCallback(async () => {
    const propostaExistente = verificarPropostaEmAndamento();
    
    if (propostaExistente) {
      dispatch({ type: 'SET_PROPOSTA_ID', payload: propostaExistente });
      return propostaExistente;
    }
    
    const novaProposta = await criarNovaProposta();
    dispatch({ 
      type: 'SET_PROPOSTA_EM_ANDAMENTO', 
      payload: { 
        id: novaProposta, 
        timestamp: new Date().toISOString() 
      } 
    });
    
    return novaProposta;
  }, [dispatch]);
  
  const salvarProgresso = useCallback((passo: number, dados: any) => {
    dispatch({ type: 'SALVAR_PROGRESSO_PASSO', payload: { passo, dados } });
  }, [dispatch]);
  
  const finalizarProposta = useCallback(() => {
    dispatch({ type: 'CLEAR_PROPOSTA_EM_ANDAMENTO' });
  }, [dispatch]);
  
  return {
    iniciarProposta,
    salvarProgresso,
    finalizarProposta
  };
};
```

## Validações e Controles

### Validação de Consistência
```typescript
// Validar se todos os passos pertencem à mesma proposta
const validarConsistenciaProposta = (): boolean => {
  const propostaId = verificarPropostaEmAndamento();
  
  if (!propostaId) return false;
  
  // Verificar se todos os passos salvos pertencem à mesma proposta
  const passos = [1, 2, 3, 4, 5];
  
  for (const passo of passos) {
    const dadosPasso = localStorage.getItem(`proposta_passo${passo}_backup`);
    if (dadosPasso) {
      const dados = JSON.parse(dadosPasso);
      if (dados.proposta_id !== propostaId) {
        console.error(`❌ Inconsistência: Passo ${passo} pertence a proposta diferente`);
        return false;
      }
    }
  }
  
  return true;
};
```

### Limpeza de Dados
```typescript
// Limpar dados apenas quando proposta for finalizada ou cancelada
const limparDadosProposta = (propostaId: string) => {
  // Verificar se é a proposta em andamento
  const propostaAtual = verificarPropostaEmAndamento();
  
  if (propostaAtual !== propostaId) {
    console.warn('⚠️ Tentativa de limpar dados de proposta diferente da atual');
    return;
  }
  
  // Limpar dados da proposta específica
  const chaves = [
    'proposta_em_andamento_id',
    'proposta_em_andamento_timestamp',
    'proposta_passo1_backup',
    'proposta_passo2_backup',
    'proposta_passo3_backup',
    'proposta_passo4_backup',
    'proposta_passo5_backup'
  ];
  
  chaves.forEach(chave => {
    localStorage.removeItem(chave);
  });
  
  console.log(`🧹 Dados da proposta ${propostaId} limpos`);
};
```

## Regras de Implementação

### ✅ OBRIGATÓRIO
1. **Verificar proposta existente** antes de criar nova
2. **Persistir ID da proposta** em todos os passos
3. **Validar consistência** entre passos
4. **Salvar progresso** automaticamente
5. **Recuperar dados** ao voltar para passos anteriores

### ❌ PROIBIDO
1. **Criar nova proposta** se já existe uma em andamento
2. **Limpar dados** sem finalizar proposta
3. **Misturar dados** de propostas diferentes
4. **Perder referência** da proposta atual
5. **Duplicar propostas** no sistema

## Fluxo de Navegação

### Navegação Entre Passos
```typescript
// Ao navegar entre passos, sempre manter referência da proposta
const navegarParaPasso = (passo: number, dados: any) => {
  const propostaId = verificarPropostaEmAndamento();
  
  if (!propostaId) {
    console.error('❌ Nenhuma proposta em andamento para navegar');
    return;
  }
  
  // Salvar progresso do passo atual
  salvarProgressoPasso(passoAtual, dados);
  
  // Navegar para próximo passo mantendo proposta
  onProximo(dados);
};
```

### Voltar para Passos Anteriores
```typescript
// Ao voltar, recuperar dados salvos da mesma proposta
const voltarParaPasso = (passo: number) => {
  const propostaId = verificarPropostaEmAndamento();
  
  if (!propostaId) {
    console.error('❌ Nenhuma proposta em andamento para voltar');
    return;
  }
  
  // Recuperar dados do passo
  const dadosPasso = localStorage.getItem(`proposta_passo${passo}_backup`);
  
  if (dadosPasso) {
    const dados = JSON.parse(dadosPasso);
    
    if (dados.proposta_id === propostaId) {
      console.log(`🔄 Recuperando dados do passo ${passo} para proposta ${propostaId}`);
      // Aplicar dados recuperados
      return dados;
    }
  }
  
  console.warn(`⚠️ Dados do passo ${passo} não encontrados para proposta ${propostaId}`);
  return null;
};
```

## Testes e Validação

### Cenários de Teste
1. **Criar nova proposta** - Deve criar apenas se não existir
2. **Voltar para passo anterior** - Deve recuperar dados da mesma proposta
3. **Navegar entre passos** - Deve manter referência da proposta
4. **Finalizar proposta** - Deve limpar dados de persistência
5. **Cancelar proposta** - Deve limpar dados sem criar duplicata

