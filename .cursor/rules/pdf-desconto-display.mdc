## Implementação no Gerador PDF

### Preparação de Dados
```python
# backend/services/pdf_generator.py
def _preparar_dados_template(self, proposta):
    """Prepara dados COMPLETOS para o template com máximo de informações"""
    
    # ✅ CORREÇÃO: Calcular desconto baseado no percentual da proposta
    percentual_desconto = proposta.percentual_desconto or 0
    
    # Carregar serviços para cada item
    itens_com_servicos = []
    for item in proposta.itens:
        if not item.ativo:
            continue
        servico = Servico.query.get(item.servico_id) if MODELS_AVAILABLE else None
        
        # ✅ CORREÇÃO: Calcular desconto baseado no percentual da proposta
        valor_unitario = float(item.valor_unitario)
        valor_total_sem_desconto = valor_unitario * float(item.quantidade)
        valor_desconto = valor_total_sem_desconto * (percentual_desconto / 100.0)
        
        item_data = {
            'servico': servico or {'nome': f'Serviço {item.id}', 'descricao': None},
            'quantidade': item.quantidade,
            'valor_unitario': valor_unitario,
            'valor_desconto': valor_desconto,  # ✅ Desconto calculado
            'valor_total': float(item.valor_total)
        }
        itens_com_servicos.append(item_data)
    
    template_data = {
        # ... outros dados
        'proposta': {
            'id': proposta.id,
            'numero': proposta.numero,
            'valor_total': proposta.valor_total,
            'valor_mensalidade': proposta.valor_mensalidade,
            'percentual_desconto': percentual_desconto,  # ✅ Percentual do banco
            'status': proposta.status,
            'observacoes': proposta.observacoes,
        },
        'itens': itens_com_servicos,
        'tem_desconto': percentual_desconto > 0,  # ✅ Flag para template
    }
    
    return template_data
```

### Validação de Desconto
```python
def _validar_desconto(self, proposta):
    """Valida se o desconto está correto"""
    percentual = proposta.percentual_desconto or 0
    
    if percentual < 0:
        print("⚠️ Percentual de desconto negativo detectado!")
        return 0
    
    if percentual > 100:
        print("⚠️ Percentual de desconto maior que 100% detectado!")
        return 100
    
    if percentual > 0:
        print(f"✅ Desconto aplicado: {percentual}%")
    else:
        print("ℹ️ Nenhum desconto aplicado")
    
    return percentual
```

