# Flask Configuration
SECRET_KEY=your-very-secure-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
FLASK_ENV=production

# Database
DATABASE_URL=sqlite:///propostas.db

# CORS Origins para produção
CORS_ORIGINS=https://propostas.christinocontabilidade.com.br,https://www.propostas.christinocontabilidade.com.br

# File Upload
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads

# Logging
LOG_LEVEL=INFO
